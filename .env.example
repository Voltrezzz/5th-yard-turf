# ============================================================
# PUBLIC (safe to expose to browser)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# ============================================================
# SERVER SECRETS (never expose to browser)
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=eyJ...
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

# ============================================================
# OPTIONAL
# ============================================================
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# Defaults to http://localhost:3000 in development.

# Phase 4 local integration only. Must be the UUID of a real auth user whose
# profile exists in the configured Supabase project. Ignored in production.
# SUPABASE_DEV_USER_ID=00000000-0000-4000-8000-000000000000
